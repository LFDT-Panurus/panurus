# SPDX-License-Identifier: Apache-2.0
#
# Fabric external builder "detect" phase: exit 0 only for Go chaincode
# packages, so the peer falls back to any other registered builder (or its
# built-in ccenv Docker build) for everything else.
set -euo pipefail

CHAINCODE_METADATA_DIR="$2"

if [ "$(jq -r '.type // empty' "$CHAINCODE_METADATA_DIR/metadata.json" | tr '[:upper:]' '[:lower:]')" = "golang" ]; then
    exit 0
fi

exit 1
