+/*
+ * Bounds checking (panurus patch). A coder started with coder_dec_begin_bnd
+ * or coder_enc_begin_bnd never reads or writes a byte at or past the end of
+ * the buffer it was given. An access that would do so sets the error flag of
+ * the state instead, every later operation on the state is a no-op, and
+ * coder_dec_end fails. Coders started with coder_dec_begin or
+ * coder_enc_begin are unbounded, as before.
+ */
+
+/* bytes that may be read starting at state->in */
+static inline size_t
+_avail_in (const coder_state_t state)
+{
+  if (!state->bounded)
+    return SIZE_MAX;
+  if (state->in == NULL || state->end == NULL || state->in >= state->end)
+    return 0;
+  return (size_t)(state->end - state->in);
+}
+
+/* bytes that may be written starting at state->out */
+static inline size_t
+_avail_out (const coder_state_t state)
+{
+  if (!state->bounded)
+    return SIZE_MAX;
+  if (state->out == NULL || state->oend == NULL || state->out >= state->oend)
+    return 0;
+  return (size_t)(state->oend - state->out);
+}
+
+/* read byte i of buf, or 0 and set *oob if i is out of bounds */
+static inline uint8_t
+_rd (const uint8_t *buf, size_t i, size_t avail, int *oob)
+{
+  if (UNLIKELY (i >= avail))
+    {
+      *oob = 1;
+      return 0;
+    }
+  return buf[i];
+}
+
+/* buf[i] |= val, or set *oob if i is out of bounds */
+static inline void
+_wr_or (uint8_t *buf, size_t i, uint8_t val, size_t avail, int *oob)
+{
+  if (UNLIKELY (i >= avail))
+    {
+      *oob = 1;
+      return;
+    }
+  buf[i] |= val;
+}
 
