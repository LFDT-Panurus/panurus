+
+/* As coder_enc_begin, but never write more than outlen bytes to out. */
+void
+coder_enc_begin_bnd (coder_state_t state, uint8_t *out, size_t outlen)
+{
+  coder_enc_begin (state, out);
+  state->bounded = 1;
+  state->oend = (out != NULL ? out + outlen : NULL);
+}
+
+/* As coder_dec_begin, but never read more than inlen bytes from in. */
+void
+coder_dec_begin_bnd (coder_state_t state, const uint8_t *in, size_t inlen)
+{
+  coder_dec_begin (state, in);
+  state->bounded = 1;
+  state->end = (in != NULL ? in + inlen : NULL);
+}
+
+/* Returns 1 if an access was out of bounds (or decoding failed), else 0. */
+int
+coder_get_err (coder_state_t state)
+{
+  return state->err != 0;
