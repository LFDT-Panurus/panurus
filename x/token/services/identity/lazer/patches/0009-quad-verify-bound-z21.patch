   int_srcptr m_ = dcompress_get_m (dcomp_param);
   INT_T (l2sqr, nlimbs * 2);
+  INT_T (l2sqrz21, nlimbs * 2);
   INT_T (bnd, nlimbs * 2);
   INT_T (linf, nlimbs);
   INT_T (tmp, 1);
@@ -496,8 +497,15 @@ lnp_quad_verify (uint8_t hash[32], poly_t c, polyvec_t z1, polyvec_t z21,
     goto ret;
   }
 
+  /*
+   * the prover rejects on l2(z21,z22)^2 <= Bsqr and the parameters bound all
+   * of z2: z21 must be bounded too, not only z22 = w - gamma*w1 (panurus
