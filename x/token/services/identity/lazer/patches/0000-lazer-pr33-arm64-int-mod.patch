+endif
 CFLAGS_WARN = -Wall -Wextra
-CFLAGS_DEFAULT = $(CFLAGS_WARN) -O3 -g -march=native -mtune=native\
+CFLAGS_DEFAULT = $(CFLAGS_WARN) -O3 -g $(CFLAGS_ARCH)\
