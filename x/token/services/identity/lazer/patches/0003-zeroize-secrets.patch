diff --git a/src/poly.c b/src/poly.c
index ea49be7..8bf9ea7 100644
--- a/src/poly.c
+++ b/src/poly.c
@@ -19,6 +19,22 @@ poly_alloc (poly_ptr r, const polyring_t ring)
   r->mem = mem;
 }
 
+/* see polyvec_wipe (panurus patch) */
+void
+poly_wipe (poly_ptr r)
+{
+  intvec_ptr coeffs;
+
+  if (r == NULL || r->coeffs == NULL)
+    return;
+  coeffs = r->coeffs;
+  /* only the limbs: the int structs that follow them stay valid */
+  bytes_clear ((uint8_t *)coeffs->bytes,
+               coeffs->nelems * _sizeof_int_data (coeffs->nlimbs));
+  if (r->crtrep != NULL)
+    bytes_clear ((uint8_t *)r->crtrep, _sizeof_crtrep_data (r->ring));
+}
+
 void
 poly_free (poly_ptr r)
 {
diff --git a/src/polymat.c b/src/polymat.c
index 9d893ad..2abdfc2 100644
--- a/src/polymat.c
+++ b/src/polymat.c
@@ -20,6 +20,23 @@ polymat_alloc (polymat_ptr r, const polyring_t ring, unsigned int nrows,
   r->mem = mem;
 }
 
+/* see polyvec_wipe (panurus patch) */
+void
+polymat_wipe (polymat_ptr r)
+{
+  unsigned int i, j;
+  poly_ptr poly;
+
+  if (r == NULL || r->elems == NULL)
+    return;
+
+  _MAT_FOREACH_ELEM (r, i, j)
+  {
+    poly = polymat_get_elem (r, i, j);
+    poly_wipe (poly);
+  }
+}
+
 void
 polymat_free (polymat_ptr r)
 {
diff --git a/src/polyvec.c b/src/polyvec.c
index 02e6e45..be207e5 100644
--- a/src/polyvec.c
+++ b/src/polyvec.c
@@ -19,6 +19,27 @@ polyvec_alloc (polyvec_ptr r, const polyring_t ring, unsigned int nelems)
   r->mem = mem;
 }
 
+/*
+ * Overwrite the coefficients (and the CRT representation, if any) of r with
+ * zeros, in a way the compiler does not elide. Use it on secrets before
+ * polyvec_free (panurus patch).
+ */
+void
+polyvec_wipe (polyvec_ptr r)
+{
+  poly_ptr poly;
+  unsigned int i;
+
+  if (r == NULL || r->elems == NULL)
+    return;
+
+  _VEC_FOREACH_ELEM (r, i)
+  {
+    poly = polyvec_get_elem (r, i);
+    poly_wipe (poly);
+  }
+}
+
 void
 polyvec_free (polyvec_ptr r)
 {
