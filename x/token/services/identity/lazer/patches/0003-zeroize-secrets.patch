+  polyvec_wipe (state->s1);
+  polyvec_wipe (state->s2);
+  polyvec_wipe (state->m);
   polyvec_free (state->s1);
   polyvec_free (state->s2);
   polyvec_free (state->m);
@@ -4814,11 +4821,16 @@ lin_prover_set_witness (lin_prover_state_t state, polyvec_t w)
 
   _lin_prover_set_witness (state, s1, l > 0 ? m : NULL);
 
+  /* copies of the witness (panurus patch) */
   if (l > 0)
     {
+      polyvec_wipe (mprime);
+      polyvec_wipe (m);
       polyvec_free (mprime);
       polyvec_free (m);
     }
+  polyvec_wipe (s1prime);
+  polyvec_wipe (s1);
   polyvec_free (s1prime);
   polyvec_free (s1);
 
@@ -4874,6 +4886,7 @@ lin_prover_prove_ctx_bnd (lin_prover_state_t state, uint8_t *proof,
                                  lin_state->u);
   rc = _lin_prover_prove (state, proof, prooflen, len,
                           coins != NULL ? coins : coins_, ctx, ctxlen);
