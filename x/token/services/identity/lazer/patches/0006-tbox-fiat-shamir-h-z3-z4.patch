+/*
+ * hash <- SHAKE128(hash || enc), enc the proof's own encoding of z3, z4 (one
+ * coder session, grandom3 with log2stdev3 then log2stdev4) on centred copies;
+ * the callers keep using z3, z4. Both are absorbed, as the proof encodes
+ * both, also when nex or nprime is 0. The coder is bounded by the exact
+ * length (coder_grandom3_nbits). Panurus patch, lazer-crypto/lazer#28.
+ */
+static void
+__lnp_tbox_hash_z34 (uint8_t hash[32], polyvec_t z3, polyvec_t z4,
+                     const lnp_tbox_params_t params)
+{
+  polyring_srcptr Rq = params->tbox->ring;
+  shake128_state_t hstate;
+  coder_state_t cstate;
+  polyvec_t a3, a4;
+  uint8_t *buf;
+  size_t len;
+
+  polyvec_alloc (a3, Rq, polyvec_get_nelems (z3));
+  polyvec_alloc (a4, Rq, polyvec_get_nelems (z4));
+  polyvec_set (a3, z3);
+  polyvec_set (a4, z4);
+  polyvec_fromcrt (a3);
+  polyvec_fromcrt (a4);
+  polyvec_mod (a3, a3);
+  polyvec_mod (a4, a4);
+  polyvec_redc (a3, a3);
+  polyvec_redc (a4, a4);
+  len = (coder_grandom3_nbits (a3, params->log2stdev3)
+         + coder_grandom3_nbits (a4, params->log2stdev4))
+            / 8
+        + 2;
+  buf = _alloc (len);
+
+  coder_enc_begin_bnd (cstate, buf, len);
+  coder_enc_grandom3 (cstate, a3, params->log2stdev3);
+  coder_enc_grandom3 (cstate, a4, params->log2stdev4);
+  coder_enc_end (cstate);
+  ASSERT_ERR (coder_get_err (cstate) == 0);
+  ASSERT_ERR (coder_get_offset (cstate) % 8 == 0);
+
+  shake128_init (hstate);
+  shake128_absorb (hstate, hash, 32);
+  shake128_absorb (hstate, buf, coder_get_offset (cstate) >> 3);
+  shake128_squeeze (hstate, hash, 32);
+  shake128_clear (hstate);
+
+  _free (buf, len);
+  polyvec_free (a4);
+  polyvec_free (a3);
+}
+
+/*
+ * hash <- SHAKE128(hash || enc), enc the proof's own encoding of h
+ * (urandom3 mod q) on a copy reduced to [0, q). Panurus patch,
+ * lazer-crypto/lazer#28.
+ */
+static void
+__lnp_tbox_hash_h (uint8_t hash[32], polyvec_t h,
+                   const lnp_tbox_params_t params)
+{
+  polyring_srcptr Rq = params->tbox->ring;
+  int_srcptr q = polyring_get_mod (Rq);
+  const unsigned int log2q = polyring_get_log2q (Rq);
+  const unsigned int d = polyring_get_deg (Rq);
+  const unsigned int n = polyvec_get_nelems (h);
+  shake128_state_t hstate;
+  coder_state_t cstate;
+  uint8_t out[CEIL (log2q * d * n, 8) + 2];
+  polyvec_t a;
+
+  polyvec_alloc (a, Rq, n);
+  polyvec_set (a, h);
+  polyvec_fromcrt (a);
+  polyvec_mod (a, a);
+  polyvec_redp (a, a);
+
+  coder_enc_begin_bnd (cstate, out, sizeof (out));
+  coder_enc_urandom3 (cstate, a, q, log2q);
+  coder_enc_end (cstate);
+  ASSERT_ERR (coder_get_err (cstate) == 0);
+  ASSERT_ERR (coder_get_offset (cstate) % 8 == 0);
+
+  shake128_init (hstate);
+  shake128_absorb (hstate, hash, 32);
+  shake128_absorb (hstate, out, coder_get_offset (cstate) >> 3);
+  shake128_squeeze (hstate, hash, 32);
+  shake128_clear (hstate);
+
+  polyvec_free (a);
+}
